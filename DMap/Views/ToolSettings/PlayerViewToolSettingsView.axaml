<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:DMap.Controls"
             xmlns:vm="using:DMap.ViewModels.ToolSettings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="DMap.Views.ToolSettings.PlayerViewToolSettingsView"
             x:DataType="vm:PlayerViewToolSettingsViewModel">

    <StackPanel Spacing="8" MinWidth="200">
        <Button Classes="text"
                Command="{Binding RotateClockwiseCommand}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="Rotate Player View">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <ui:Icon Width="16" Height="16" IconName="rotate-cw-square" />
                <TextBlock Text="Rotate View" />
            </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="toolSetting" Text="Padding" VerticalAlignment="Center" />
            <NumericUpDown Classes="toolSetting"
                           Grid.Column="1"
                           Value="{Binding Padding}"
                           Minimum="0"
                           Maximum="256"
                           Increment="1"
                           FormatString="0" />
        </Grid>
    </StackPanel>
</UserControl>
